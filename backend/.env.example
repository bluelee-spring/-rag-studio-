# 后端服务
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Neo4j教学实例。密码只写在本机.env中。
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# 可选：Apache Jena Fuseki查询端点。
# 为空时使用项目内嵌的RDFLib数据集。
FUSEKI_QUERY_URL=

# OpenAI兼容API。未配置时系统使用确定性教学规划器。
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
ENABLE_LLM_PLANNER=false
ENABLE_LLM_ANSWER=true
